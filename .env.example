# Exemplo público. Não contém credenciais reais.
# Execute python3 scripts/setup-local.py para criar .env com senha aleatória.
EDIVO_ENV=development
EDIVO_LOG_LEVEL=INFO
EDIVO_UID=1000
EDIVO_GID=1000
POSTGRES_USER=edivo
POSTGRES_DB=edivo
# Use senha hexadecimal gerada pelo setup, sem caracteres reservados de URL.
POSTGRES_PASSWORD=SUBSTITUA_POR_SENHA_LOCAL_ALEATORIA
EDIVO_CORS_ORIGINS='["http://127.0.0.1:5173","http://localhost:5173"]'
# Apenas para execução Python fora do Compose; o hostname db pertence à rede Docker.
EDIVO_DATABASE_URL=postgresql+psycopg://edivo:SUBSTITUA_POR_SENHA_LOCAL_ALEATORIA@db:5432/edivo
EDIVO_STORAGE_ROOT=../storage
EDIVO_FFMPEG_BIN=ffmpeg
EDIVO_FFPROBE_BIN=ffprobe
EDIVO_DATABASE_CONNECT_TIMEOUT=2
EDIVO_FFMPEG_TIMEOUT_SECONDS=5
EDIVO_CAPABILITIES_CACHE_SECONDS=300
